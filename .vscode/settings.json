{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/ai video generation/**": true,
    "**/public/frames/**": true,
    "**/public/*.mp4": true,
    "**/public/models/**": true,
    "**/GLB/**": true,
